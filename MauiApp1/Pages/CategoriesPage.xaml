<?xml version="1.0" encoding="utf-8" ?>
<mauiApp1:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:mauiApp1="clr-namespace:MauiApp1"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             xmlns:categories="clr-namespace:MauiApp1.Views.Categories"
             x:Class="MauiApp1.Pages.CategoriesPage">

    <Grid RowDefinitions="Auto, *"> 
    
       
      
        <categories:HorizontalCategoriesView x:Name="HorizontalCategoriesView" Grid.Row="0" />
     
    
        <notes:VerticalNotesView Grid.Row="1" x:Name="VerticalNotesView"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill"/>
        
        <AbsoluteLayout Grid.Row="1">
            <categories:CreateCategoryButtonView x:Name="CreateCategoryButtonView"
                                        AbsoluteLayout.LayoutBounds="1,1,AutoSize,AutoSize"
                                        AbsoluteLayout.LayoutFlags="PositionProportional"
                                        Margin="20" />
        </AbsoluteLayout>
    </Grid>

</mauiApp1:BasePage>

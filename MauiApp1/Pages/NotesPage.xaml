<?xml version="1.0" encoding="utf-8"?>

<mauiApp1:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiApp1="clr-namespace:MauiApp1"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Pages.NotesPage">
    <Grid>
        <ScrollView>
            <VerticalStackLayout x:Name="Layout"
                                 Spacing="25">
            </VerticalStackLayout>
        </ScrollView>
        <AbsoluteLayout>
            <notes:CreateNoteButtonView x:Name="CreateNoteButtonView"
                                        AbsoluteLayout.LayoutBounds="1,1,AutoSize,AutoSize"
                                        AbsoluteLayout.LayoutFlags="PositionProportional"
                                        Margin="20" />
        </AbsoluteLayout>
    </Grid>
</mauiApp1:BasePage>
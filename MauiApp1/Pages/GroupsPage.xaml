<?xml version="1.0" encoding="utf-8"?>

<mauiApp1:BasePage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiApp1="clr-namespace:MauiApp1"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             xmlns:groups="clr-namespace:MauiApp1.Views.Groups"
             x:Class="MauiApp1.Pages.GroupsPage">
    <Grid RowDefinitions="*, Auto">
        <groups:VerticalGroupsView Grid.Row="0" x:Name="VerticalGroupsView" HorizontalOptions="Fill" VerticalOptions="Fill"/>
        
        <Border Grid.Row="1" x:Name="BottomContainer"/>
    </Grid>

</mauiApp1:BasePage>
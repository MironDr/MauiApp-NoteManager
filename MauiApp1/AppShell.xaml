<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    xmlns:view="clr-namespace:MauiApp1.View"
    xmlns:pages="clr-namespace:MauiApp1.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="MauiApp1">

    
    <ShellContent
        Title="Notes"
        ContentTemplate="{DataTemplate pages:NotesPage}"
        Route="NotesPage" />
    
    <ShellContent
        Title="Categories"
        ContentTemplate="{DataTemplate local:CategoriesPage}"
        Route="CategoriesPage" />
    
    <ShellContent
        Title="Groups"
        ContentTemplate="{DataTemplate pages:GroupsPage}"
        Route="GroupsPage" />

</Shell>

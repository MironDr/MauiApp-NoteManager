<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:groups="clr-namespace:MauiApp1.Views.Groups"
             x:Class="MauiApp1.Views.ProtectionProfiles.ProtectionProfileItemView">
    <Grid RowDefinitions="Auto, *">
        <Label Text="{Binding Name}"  
               HorizontalOptions="Center"
               FontSize="Title"
               FontAttributes="Bold"
               Margin="0,10,0,20" Grid.Row="0"/>
        <CollectionView ItemsSource="{Binding NotesList}" SelectionMode="None" Grid.Row="1">
            <CollectionView.EmptyView>
                <Label Text="No notes" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center"
                       TextColor="{StaticResource SecondaryDarkText}"
                       TextTransform="Uppercase"
                       FontSize="Title"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button
                        Text="{Binding Title}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <AbsoluteLayout Grid.Row="1">
            <groups:NoteSelectorButtonView x:Name="SelectorButtonView"
                                                  AbsoluteLayout.LayoutBounds="1,1,AutoSize,AutoSize"
                                                  AbsoluteLayout.LayoutFlags="PositionProportional"
                                                  Margin="20" />
        </AbsoluteLayout>
    </Grid>
</view:BaseView>
<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.ProtectionProfiles.CreateProtectionProfileView">
    <StackLayout>
        <Label Text="Create Profile" FontSize="20" />
        
        <Entry Placeholder="Profile Name"
               Text="{Binding Profile.ProfileName}" />
        <Entry Placeholder="Password"
               Text="{Binding Profile.Password}" IsPassword="True"/>
        <Entry Placeholder="Repeat Password"
               Text="{Binding Profile.PasswordRepeat}" IsPassword="True"/>
        <Button Text="Create"
                Command="{Binding SaveProfileCommand}" />
        
    </StackLayout>

</view:BaseView>
<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Views.Notes.NoteItemView">
    <ScrollView>
        <VerticalStackLayout Padding="10" x:Name="MainLayout" Spacing="10">

            <Switch IsToggled="False" Toggled="Switch_OnToggled" x:Name="SwitchView"/>
            <VerticalStackLayout  x:Name="ReadModeView" IsVisible="True">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <notes:CustomEntryView />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="DynamicContentArea" />
            </VerticalStackLayout>
           
            
            <notes:EditNoteView x:Name="EditModeView" IsVisible="False"/>
           
        </VerticalStackLayout>
    </ScrollView>
</view:BaseView>
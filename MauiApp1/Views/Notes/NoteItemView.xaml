<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Views.Notes.NoteItemView">
    <VerticalStackLayout Padding="20">
        <Switch IsToggled="False" Toggled="Switch_OnToggled"/>
        <CollectionView x:Name="ReadModeView" IsVisible="True" ItemsSource="{Binding Fields}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <notes:CustomFieldView />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <notes:EditNoteView x:Name="EditModeView" IsVisible="False"/>
    </VerticalStackLayout>
</view:BaseView>
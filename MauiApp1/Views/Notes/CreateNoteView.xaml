<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:categories="clr-namespace:MauiApp1.Views.Categories"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Views.Notes.CreateNoteView">
    <ScrollView>
        <VerticalStackLayout Padding="10" x:Name="MainLayout" Spacing="10">

         
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <notes:CustomEntryView />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            
            <VerticalStackLayout x:Name="DynamicContentArea" />
         
            <categories:CategorySelectorView x:Name="CategorySelectorView" />

         
            <Button Text="Create"
                    Command="{Binding SaveNoteCommand}"
                    x:Name="SaveButton" />
        </VerticalStackLayout>
    </ScrollView>
    
</view:BaseView>
<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:categories="clr-namespace:MauiApp1.Views.Categories"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Views.Notes.CreateNoteView">
    <StackLayout>
        <StackLayout x:Name="MainLayout">
            <CollectionView ItemsSource="{Binding Fields}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <notes:CustomFieldView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
        <categories:CategorySelectorView x:Name="CategorySelectorView"/>
        
        <Button Text="Create"
                Command="{Binding SaveNoteCommand}" x:Name="SaveButton"/>
        
    </StackLayout>
    
</view:BaseView>
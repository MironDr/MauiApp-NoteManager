<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.Notes.VerticalNotesView">
        <Grid x:Name="MainLayout">
            <CollectionView ItemsSource="{Binding Notes}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No matching notes" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="{StaticResource SecondaryDarkText}"
                           TextTransform="Uppercase"
                           FontSize="Title"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Text="{Binding Title}"
                            Command="{Binding BindingContext.NoteSelectedCommand, Source={x:Reference MainLayout}}"
                            CommandParameter="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
</view:BaseView>
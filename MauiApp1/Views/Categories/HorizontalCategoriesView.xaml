<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:categories="clr-namespace:MauiApp1.Views.Categories"
             x:Class="MauiApp1.Views.Categories.HorizontalCategoriesView">
    <ScrollView Orientation="Horizontal">
    <StackLayout x:Name="MainLayout" Orientation="Horizontal">
        <SwipeView>
            <SwipeView.LeftItems>
                <SwipeItems>
                    <SwipeItem
                        Text="Delete"
                        BackgroundColor="DarkRed"
                        Command="{Binding DeleteCategoryCommand}"/>
                </SwipeItems>
            </SwipeView.LeftItems>
            <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Button Text="{Binding Category.CategoryName}" Command="{Binding Command}" CommandParameter="{Binding .}" Style="{Binding Style}"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </SwipeView>
    </StackLayout>
    </ScrollView>
</view:BaseView>
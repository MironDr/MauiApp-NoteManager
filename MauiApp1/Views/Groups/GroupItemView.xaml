<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:groups="clr-namespace:MauiApp1.Views.Groups"
             x:Class="MauiApp1.Views.Groups.GroupItemView">
    <Grid>
        <ScrollView>
            <VerticalStackLayout>
                <Label Text="{Binding GroupName}" 
                       HorizontalOptions="Center"
                       FontSize="Title"
                       FontAttributes="Bold"
                       Margin="0,10,0,20"/>
                <VerticalStackLayout x:Name="MainStack" Padding="10" Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>
        
        <AbsoluteLayout>
            <groups:NoteToGroupSelectorButtonView x:Name="SelectorButtonView"
                                          AbsoluteLayout.LayoutBounds="1,1,AutoSize,AutoSize"
                                          AbsoluteLayout.LayoutFlags="PositionProportional"
                                          Margin="20" />
        </AbsoluteLayout>
    </Grid>
</view:BaseView>
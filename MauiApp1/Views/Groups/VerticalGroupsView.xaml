<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.Groups.VerticalGroupsView">
    <StackLayout x:Name="MainLayout" Orientation="Vertical">
        <CollectionView ItemsSource="{Binding Groups}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button
                        Text="{Binding GroupName}"
                        Command="{Binding BindingContext.GroupSelectedCommand, Source={x:Reference MainLayout}}"
                        CommandParameter="{Binding .}" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</view:BaseView>
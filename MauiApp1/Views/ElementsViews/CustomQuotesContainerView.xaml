<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.Notes.CustomQuotesContainerView">
    <VerticalStackLayout>
        <Label Text = "Sources"/>
        <Border Padding="5">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <VerticalStackLayout>
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <notes:CustomInfoView/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <notes:CreateNoteWithSourceButtonView x:Name="CreateButton"/>
                <notes:DeleteNoteWithSourceButtonView x:Name="DeleteButton"/>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</view:BaseView>
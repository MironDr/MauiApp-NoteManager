<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             xmlns:notes="clr-namespace:MauiApp1.Views.Notes"
             x:Class="MauiApp1.Views.ElementsViews.TextBlocksView">
  
        <VerticalStackLayout>
            <Border Padding="5" IsVisible="{Binding IsEdit}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="6" />
                </Border.StrokeShape>
                <HorizontalStackLayout HorizontalOptions="Center" >
                    <Label Text="Text Blocks" HorizontalOptions="Start" VerticalOptions="Center" Padding="50,0"/>
                    <Button Command="{Binding AddNewBlockCommand}" Text="+" VerticalOptions="Center" HorizontalOptions="End" Padding="50,0"/>
                </HorizontalStackLayout>
            </Border>
            <CollectionView ItemsSource="{Binding Blocks}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <notes:CustomEditorView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
  
    
</view:BaseView>
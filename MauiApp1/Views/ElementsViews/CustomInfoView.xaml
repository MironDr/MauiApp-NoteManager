<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.Notes.CustomInfoView">
    <VerticalStackLayout>
        <Border>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Fields}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="5">
                            <Label Text="{Binding Title}"/>
                            <Label Text="{Binding Content}"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </Border>
    </VerticalStackLayout>
</view:BaseView>
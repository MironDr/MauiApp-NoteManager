<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.Notes.CustomCheckBoxView">
    <HorizontalStackLayout IsVisible="{Binding IsNonEmptyField}">
        <CheckBox IsChecked="{Binding Status}" IsEnabled="{Binding IsReadOnly}"/>
        <Entry Text="{Binding Title}" IsReadOnly="{Binding IsReadOnly}" HorizontalOptions="Fill"/>
    </HorizontalStackLayout>
</view:BaseView>
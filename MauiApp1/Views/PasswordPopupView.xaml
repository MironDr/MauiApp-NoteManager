<?xml version="1.0" encoding="utf-8"?>

<view:BaseView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.View"
             x:Class="MauiApp1.Views.PasswordPopupView">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label x:Name="ProfileLabel" FontSize="Title"/>
        <Label Text="Enter Password:" />
        <Entry x:Name="PasswordEntry" IsPassword="True" />

        <HorizontalStackLayout Spacing="10">
            <Button Text="Cancel" Clicked="OnCancelClicked" />
            <Button Text="Ok" Clicked="OnOkClicked" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</view:BaseView>